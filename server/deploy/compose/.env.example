# Plumb backend — environment template.
# Copy to `.env` next to docker-compose.yml and edit. `.env` is git-ignored.

# --- exposure ---------------------------------------------------------------
# 127.0.0.1 keeps the service on the local machine only.
# Use 0.0.0.0 to reach it from another machine on the LAN — turn auth on first.
PLUMB_BIND=127.0.0.1

# --- CORS -------------------------------------------------------------------
# The origin(s) serving the Plumb client. Never leave this as "*" in production.
ALLOWED_ORIGINS=https://ethical-tech-colab.github.io,http://localhost:8777

# Public base URL of this backend, used to build image_url in contract exports.
# e.g. https://plumb.example.org  or  https://plumb-backend.<region>.azurecontainerapps.io
PLUMB_PUBLIC_BASE_URL=

# --- auth -------------------------------------------------------------------
# Mandatory for anything reachable beyond localhost.
PLUMB_REQUIRE_AUTH=false
# Comma-separated. Generate with: openssl rand -hex 32
PLUMB_API_TOKENS=

# --- trust services ---------------------------------------------------------
# RFC 3161 timestamp authority. https://freetsa.org/tsr works for development.
PLUMB_TSA_URL=

# C2PA signing. All three must be set for signing to be enabled; otherwise
# artifacts are explicitly reported as unsigned.
PLUMB_C2PA_TOOL=
PLUMB_C2PA_CERT=
PLUMB_C2PA_KEY=

# --- digital-3d contract ----------------------------------------------------
PLUMB_MODULE_ID=plumb-photo-survey
PLUMB_FRAME_ID=nyc-harbor-enu
PLUMB_CAMPAIGN_ID=plumb-field-capture

# --- storage ----------------------------------------------------------------
# local | azure_blob
PLUMB_STORAGE=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_RAW_CONTAINER=plumb-raw
